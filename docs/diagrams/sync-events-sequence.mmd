sequenceDiagram
    participant Poller as Poller / manual trigger
    participant SyncApp as Sync use case
    participant Syncer as CalendarSyncer port
    participant DB as Repository

    Poller->>SyncApp: ExecuteSync(ruleID)
    SyncApp->>DB: load rule (must be Active)

    alt has syncCursor
        SyncApp->>Syncer: FetchChanges(sourceCalID, cursor)
        Syncer-->>SyncApp: ChangeSet + newCursor
    else no syncCursor (first run / after resume)
        SyncApp->>Syncer: FetchChanges(sourceCalID, "")
        Syncer-->>SyncApp: all events + newCursor
    end

    alt ErrCursorExpired
        SyncApp->>DB: clear cursor + all mappings
        SyncApp->>Syncer: FetchChanges(sourceCalID, "")
        Syncer-->>SyncApp: all events + newCursor
    end

    SyncApp->>SyncApp: apply FilterPolicy + build blocks

    loop each changed event
        alt new (no mapping)
            SyncApp->>Syncer: CreateBlock(targetCalID, block)
            Syncer-->>SyncApp: blockID
            SyncApp->>DB: save mapping
        else updated (mapping exists)
            SyncApp->>Syncer: UpdateBlock(targetCalID, blockID, block)
            SyncApp->>DB: update mapping
        else cancelled (mapping exists)
            SyncApp->>Syncer: DeleteBlock(targetCalID, blockID)
            SyncApp->>DB: remove mapping
        end
    end

    SyncApp->>DB: update rule.syncCursor
    SyncApp-->>Poller: done

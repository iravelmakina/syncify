{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "connections-route": {
        "ClusterId": "connections",
        "Match": {
          "Path": "/connections/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/connections" }
        ]
      },
      "sync-route": {
        "ClusterId": "sync",
        "Match": {
          "Path": "/sync-rules/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/sync-rules" }
        ]
      }
    },
    "Clusters": {
      "connections": {
        "Destinations": {
          "default": {
            "Address": "http://connections-service:8080"
          }
        }
      },
      "sync": {
        "Destinations": {
          "default": {
            "Address": "http://sync-service:8080"
          }
        }
      }
    }
  }
}